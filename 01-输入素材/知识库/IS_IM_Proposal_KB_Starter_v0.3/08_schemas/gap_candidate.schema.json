{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GapCandidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "gap_id",
    "gap_type",
    "statement",
    "supporting_claim_ids",
    "is_im_relevance",
    "feasibility",
    "status"
  ],
  "properties": {
    "gap_id": {
      "type": "string"
    },
    "gap_type": {
      "type": "string"
    },
    "statement": {
      "type": "string"
    },
    "supporting_claim_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "counterevidence_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "is_im_relevance": {
      "type": "string"
    },
    "required_paradigm_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "data_requirements": {
      "type": "string"
    },
    "novelty_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 5
    },
    "evidence_strength_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 5
    },
    "feasibility": {
      "enum": [
        "high",
        "medium",
        "low",
        "unknown"
      ]
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "enum": [
        "candidate",
        "selected",
        "rejected",
        "needs_evidence"
      ]
    }
  }
}