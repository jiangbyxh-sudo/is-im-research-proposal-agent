{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proposal-compass.local/schemas/paper-record-p1.json",
  "title": "PaperRecord P1",
  "description": "Provider-neutral, provenance-preserving paper record after normalization.",
  "type": "object",
  "additionalProperties": true,
  "required": ["paper_id", "title", "authors", "year", "language", "source_title", "document_type", "providers", "field_sources", "integrity_status", "evidence_level"],
  "properties": {
    "paper_id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "abstract": {"type": ["string", "null"]},
    "authors": {"type": "array", "items": {"type": "string"}},
    "year": {"type": "integer", "minimum": 1900, "maximum": 2100},
    "publication_date": {"type": ["string", "null"]},
    "language": {"enum": ["zh", "en"]},
    "doi": {"type": ["string", "null"]},
    "official_url": {"type": ["string", "null"]},
    "source_title": {"type": "string", "minLength": 1},
    "source_issns": {"type": "array", "items": {"type": "string"}},
    "journal_id": {"type": "string"},
    "journal_ranking": {"type": "array", "items": {"type": "string"}},
    "journal_pool_ids": {"type": "array", "items": {"type": "string"}},
    "document_type": {"enum": ["journal-article", "proceedings-article"]},
    "citation_count": {"type": "integer", "minimum": 0},
    "external_ids": {"type": "object", "additionalProperties": {"type": "string"}},
    "providers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "field_sources": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": "string"}}},
    "integrity_status": {"enum": ["clear", "corrected", "retracted", "expression_of_concern", "unknown"]},
    "evidence_level": {"enum": ["fulltext", "abstract", "title_only"]},
    "untrusted_text_isolated": {"type": "boolean"},
    "checkpoint": {
      "type": "object",
      "required": ["passed", "reasons", "version"],
      "properties": {"passed": {"type": "boolean"}, "reasons": {"type": "array", "items": {"type": "string"}}, "version": {"type": "string"}}
    },
    "score": {
      "type": "object",
      "required": ["config_version", "total", "band", "components", "weights", "threshold_calibration_status"],
      "properties": {
        "config_version": {"type": "string"},
        "total": {"type": "number", "minimum": 0, "maximum": 100},
        "band": {"enum": ["reject", "boundary", "eligible", "high"]},
        "components": {"type": "object"},
        "weights": {"type": "object"},
        "threshold_calibration_status": {"const": "uncalibrated"}
      }
    }
  }
}
