{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proposal-compass.local/schemas/direction-profile-v1.json",
  "title": "DirectionProfile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile_version", "direction_id", "labels", "group_ids", "synonyms",
    "boundaries", "provider_queries", "topic_routes", "source_routes",
    "journal_pool_ids", "document_types", "fallback_queries", "coverage_targets"
  ],
  "properties": {
    "profile_version": {"type": "string", "minLength": 1},
    "direction_id": {"type": "string", "minLength": 1},
    "labels": {
      "type": "object",
      "required": ["zh", "en"],
      "properties": {"zh": {"type": "string", "minLength": 1}, "en": {"type": "string", "minLength": 1}}
    },
    "group_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "synonyms": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "boundaries": {
      "type": "object", "required": ["include", "exclude"],
      "properties": {
        "include": {"type": "array", "minItems": 2, "items": {"type": "string"}},
        "exclude": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "provider_queries": {
      "type": "object", "required": ["openalex", "semantic_scholar", "crossref", "dblp"],
      "additionalProperties": {"type": "array", "minItems": 1, "items": {"type": "string"}}
    },
    "topic_routes": {"type": "object", "required": ["strategy", "topic_search_terms", "openalex_topic_ids", "status"]},
    "source_routes": {"type": "object", "required": ["required", "optional", "licensed_optional"]},
    "journal_pool_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "document_types": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "fallback_queries": {"type": "array", "minItems": 2, "items": {"type": "string"}},
    "coverage_targets": {
      "type": "object", "required": ["raw_min", "eligible_min", "precision_at_20_min"],
      "properties": {
        "raw_min": {"type": "integer", "minimum": 1},
        "eligible_min": {"type": "integer", "minimum": 1},
        "precision_at_20_min": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "source_refs": {"type": "array", "items": {"type": "string"}}
  }
}
