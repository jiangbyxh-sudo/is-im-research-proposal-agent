{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ResearchRequest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "session_id",
    "selected_direction_id",
    "research_direction",
    "chinese_count",
    "english_count",
    "derived_path",
    "submitted_at"
  ],
  "properties": {
    "session_id": {"type": "string", "minLength": 1},
    "selected_direction_id": {"type": "string", "minLength": 1},
    "research_direction": {"type": "string", "minLength": 1},
    "fine_grained_question": {"type": "string", "minLength": 1},
    "chinese_count": {"type": "integer", "minimum": 1, "default": 10},
    "english_count": {"type": "integer", "minimum": 1, "default": 20},
    "derived_path": {
      "enum": ["focused_question", "top_five_subdirections"],
      "readOnly": true
    },
    "popularity_window_years": {"type": "integer", "const": 5, "default": 5},
    "direction_source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    },
    "submitted_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {
      "if": {"required": ["fine_grained_question"]},
      "then": {"properties": {"derived_path": {"const": "focused_question"}}},
      "else": {"properties": {"derived_path": {"const": "top_five_subdirections"}}}
    }
  ]
}
